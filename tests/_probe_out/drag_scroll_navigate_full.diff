+def _drag_verify_held(page, thumb_el, target, recorded_before, live_before, pos, axis, end_delta):
+    """Called while the mouse button is STILL DOWN at the drag's final
+    position. Confirms the control currently shows the RECORDED value
+    (that is what the recorder captured - the value the user saw at the
+    moment they let go; see action_capture.js's _finishDragGesture), and if
+    it doesn't, does what a person does: nudge the pointer by the remaining
+    distance (bounded DRAG_NUDGE_MAX_ATTEMPTS) before releasing. Reading it
+    here, not after release, matters: many widgets re-render their own
+    label once the released value is applied (CONFIRMED on a real
+    price-range filter: label showed the dragged value until ~0.5s after
+    release, then was rewritten from the refreshed results), so a value read
+    after a settle wait can legitimately differ from the value at release
+    while the drag itself landed exactly right.
+
+    Returns (matched, last_value_read, nudges_used). A control whose label
+    does not change while dragging at all (updates only on release) is left
+    alone - nothing is nudged, since there is no live signal to steer by."""
+    def read():
+        return _captureDragValueSnapshot_py(thumb_el)
+
+    cur = read()
+    deadline = time.monotonic() + DRAG_HELD_POLL_BUDGET_S
+    while not _drag_reached(cur, target, recorded_before) and time.monotonic() < deadline:
+        page.wait_for_timeout(60)
+        cur = read()
+    if _drag_reached(cur, target, recorded_before):
+        return True, cur, 0
+    if cur is None or (live_before is not None and _drag_values_equal(cur, live_before)):
+        return False, cur, 0
+
+    print(
+        f"[drag] value while held {cur!r} != recorded {target!r} - "
+        f"nudging the pointer (up to {DRAG_NUDGE_MAX_ATTEMPTS} corrections) before release"
+    )
+    x, y = pos
+    tn = _drag_numbers(target)
+    bn = _drag_numbers(recorded_before)
+    slope = None
+    d_px = (end_delta or {}).get("dx" if axis == "x" else "dy") or 0
+    if bn and len(bn) == len(tn) and d_px:
+        diffs = [i for i in range(len(tn)) if tn[i] != bn[i]]
+        if diffs:
+            slope = (tn[diffs[0]] - bn[diffs[0]]) / d_px
+    nudges = 0
+    stalled = 0
+    for _ in range(DRAG_NUDGE_MAX_ATTEMPTS):
+        cn = _drag_numbers(cur)
+        if not cn or len(cn) != len(tn):
+            break
+        # steer by the number(s) the drag changed, not by whichever number
+        # happens to differ first (see _drag_reached)
+        idxs = [i for i in (_drag_changed_indices(recorded_before, target) or range(len(tn))) if cn[i] != tn[i]]
+        if not idxs:
+            break
+        idx = idxs[0]
+        delta_units = tn[idx] - cn[idx]
+        px = (delta_units / slope) if slope else 3.0
+        # a stepped/snapping control ignores a move that doesn't cross its
+        # next snap point (the value doesn't change, so no slope is
+        # learned): push further each time it stalls, like a person would
+        px *= 2 ** stalled
+        px = max(-80.0, min(80.0, px))
+        if abs(px) < 0.5:
+            px = 0.5 if px >= 0 else -0.5
+        if axis == "x":
+            x += px
+        else:
+            y += px
+        page.mouse.move(x, y, steps=max(1, int(abs(px) / 5)))
+        page.wait_for_timeout(100)
+        nudges += 1
+        new = read()
+        print(f"[drag] nudge {nudges}: moved {px:+.1f}px along {axis} -> value now {new!r}")
+        nn = _drag_numbers(new)
+        if new is not None and len(nn) == len(cn) and nn[idx] != cn[idx]:
+            slope = (nn[idx] - cn[idx]) / px   # px = the distance actually moved
+            stalled = 0
+        else:
+            stalled += 1
+        cur = new
+        if _drag_reached(cur, target, recorded_before):
+            return True, cur, nudges
+    return False, cur, nudges
+
+
+def _drag_poll_for_value(page, thumb_el, target, budget_s, before=None):
+    """Bounded poll (after release) for the recorded value to be on screen at
+    ANY moment - covers widgets that only update their label once the
+    button is released."""
+    deadline = time.monotonic() + budget_s
+    cur = _captureDragValueSnapshot_py(thumb_el)
+    while not _drag_reached(cur, target, before) and time.monotonic() < deadline:
+        page.wait_for_timeout(100)
+        cur = _captureDragValueSnapshot_py(thumb_el)
+    return _drag_reached(cur, target, before), cur
+
