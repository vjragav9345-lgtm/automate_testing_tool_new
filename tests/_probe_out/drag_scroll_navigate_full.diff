+def _drag_slider_under_pointer(page, x, y):
+    """The slider-like element (native range input / role=slider /
+    aria-valuenow, within 4 ancestors) that is actually under the pointer
+    at (x, y) - i.e. the thing the browser is about to drag - or None.
+    Geometry, not a locator: a recorded thumb profile can be ambiguous or
+    stale on a page with dozens of look-alike sliders (CONFIRMED: it
+    re-resolved to a scale label showing the same number), the element
+    under the pointer cannot be."""
+    try:
+        return page.evaluate_handle(_DRAG_SLIDER_UNDER_POINT_JS, [x, y]).as_element()
+    except Exception:
+        return None
+
