+class _DragValueSource:
+    """Read-only evaluate() proxy for the drag's value reads: the element
+    proven (by geometry) to be under the pointer while the button is held,
+    falling back to the locator-resolved thumb once that handle is gone
+    (a page that re-renders after release)."""
+
+    def __init__(self, primary, fallback):
+        self.primary = primary
+        self.fallback = fallback
+
+    def evaluate(self, expression, arg=None):
+        if self.primary is not None:
+            try:
+                return self.primary.evaluate(expression, arg)
+            except Exception:
+                self.primary = None
+        return self.fallback.evaluate(expression, arg)
+
